@using MediatR
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using QuantumSummerLab.Application.Teams.Commands
@using QuantumSummerLab.Application.Teams.Queries
@using QuantumSummerLab.Web.Helpers

@inject ProtectedLocalStorage ProtectedLocalStore
@inject IMediator Mediator
@inject NavigationHelper NavigationHelper

@page "/teams"

<PageTitle>Quantum Summer Lab - Team management</PageTitle>

<MudText Typo="Typo.h4" Class="my-4">Team management</MudText>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (!IsLoggedIn)
{
    <MudAlert Severity="Severity.Info" Class="my-4">You need to log in before accessing team management.</MudAlert>
}
else if (!IsAdmin)
{
    <MudAlert Severity="Severity.Warning" Class="my-4">Only approved admin teams can access this page.</MudAlert>
}
else
{
    @if (!string.IsNullOrEmpty(Message))
    {
        <MudAlert Severity="@(IsErrorMessage ? Severity.Error : Severity.Success)" Class="my-4">@Message</MudAlert>
    }

    <MudCard Outlined="true" Class="mt-6">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Registered teams</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudDataGrid T="ManagedTeamDto" Items="@ManagedTeams" Dense="true" Hover="true" Bordered="true" Striped="true" SortMode="SortMode.Multiple">
            <Columns>
                <PropertyColumn Property="x => x.TeamName" Title="Team" />
                <PropertyColumn Property="x => x.IsApproved" Title="Approved">
                    <CellTemplate>
                        <MudChip T="string" Color="@(context.Item.IsApproved ? Color.Success : Color.Warning)">
                            @(context.Item.IsApproved ? "Approved" : "Pending")
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.IsAdmin" Title="Admin">
                    <CellTemplate>
                        <MudChip T="string" Color="@(context.Item.IsAdmin ? Color.Success : Color.Default)">
                            @(context.Item.IsAdmin ? "Admin" : "Member")
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.IsArchived" Title="Status">
                    <CellTemplate>
                        <MudChip T="string" Color="@(context.Item.IsArchived ? Color.Error : Color.Success)">
                            @(context.Item.IsArchived ? "Archived" : "Active")
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.SubmissionCount" Title="Submissions" />
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        @if (!context.Item.IsArchived)
                        {
                            <MudTooltip Text="Approve team">
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                               Size="Size.Small"
                                               Color="Color.Info"
                                               Disabled="@context.Item.IsApproved"
                                               OnClick="@(() => ApproveTeam(context.Item.TeamId))" />
                            </MudTooltip>
                            <MudTooltip Text="@(context.Item.IsAdmin ? "Demote admin" : "Promote admin")">
                                <MudIconButton Icon="@(context.Item.IsAdmin ? Icons.Material.Filled.RemoveModerator : Icons.Material.Filled.AddModerator)"
                                               Size="Size.Small"
                                               Color="@(context.Item.IsAdmin ? Color.Warning : Color.Success)"
                                               OnClick="@(() => SetAdmin(context.Item.TeamId, !context.Item.IsAdmin))" />
                            </MudTooltip>
                            <MudTooltip Text="Archive team">
                                <MudIconButton Icon="@Icons.Material.Filled.Archive"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => ArchiveTeam(context.Item.TeamId))" />
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudCard>
}
