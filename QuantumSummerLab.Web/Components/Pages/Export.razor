@using System.Text
@using System.Text.Json
@using MediatR
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using QuantumSummerLab.Application.Export.Queries
@using QuantumSummerLab.Application.Teams.Commands
@using QuantumSummerLab.Application.Teams.Queries

@inject ProtectedLocalStorage ProtectedLocalStore
@inject IMediator Mediator
@inject IJSRuntime JS

@page "/export"

<PageTitle>Quantum Summer Lab - Data export</PageTitle>

<MudText Typo="Typo.h4" Class="my-4">Data export</MudText>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (!IsLoggedIn)
{
    <MudAlert Severity="Severity.Info" Class="my-4">You need to log in before accessing the data export.</MudAlert>
}
else if (!IsAdmin)
{
    <MudAlert Severity="Severity.Warning" Class="my-4">Only approved admin teams can access this page.</MudAlert>
}
else
{
    <MudText Class="mb-4">Export all platform data (teams, challenges, scores, chats, and leaderboard) into a single structured JSON file.</MudText>

    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Outlined="true" Class="pa-4 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.Group" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Class="mt-2">@Statistics.TeamCount</MudText>
                <MudText Typo="Typo.body2">Teams</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Outlined="true" Class="pa-4 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.Extension" Color="Color.Secondary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Class="mt-2">@Statistics.ChallengeCount</MudText>
                <MudText Typo="Typo.body2">Challenges</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Outlined="true" Class="pa-4 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.PlaylistAddCheck" Color="Color.Success" Size="Size.Large" />
                <MudText Typo="Typo.h4" Class="mt-2">@Statistics.SubmissionCount</MudText>
                <MudText Typo="Typo.body2">Submissions</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Outlined="true" Class="pa-4 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.Forum" Color="Color.Info" Size="Size.Large" />
                <MudText Typo="Typo.h4" Class="mt-2">@Statistics.ChatMessageCount</MudText>
                <MudText Typo="Typo.body2">Chat messages</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Download"
               Disabled="@IsExporting"
               OnClick="@ExportData">
        @if (IsExporting)
        {
            <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
            <span>Exporting...</span>
        }
        else
        {
            <span>Export to JSON</span>
        }
    </MudButton>
}
