@using MediatR
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using QuantumSummerLab.Application.Teams.Commands
@using QuantumSummerLab.Application.Teams.Queries

@inject ProtectedLocalStorage ProtectedLocalStore
@inject IMediator Mediator

@page "/reports"

<PageTitle>Quantum Summer Lab - Challenge reports</PageTitle>

<MudText Typo="Typo.h4" Class="my-4">Challenge reports</MudText>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (!IsLoggedIn)
{
    <MudAlert Severity="Severity.Info" Class="my-4">You need to log in before accessing challenge reports.</MudAlert>
}
else if (!IsAdmin)
{
    <MudAlert Severity="Severity.Warning" Class="my-4">Only approved admin teams can access this page.</MudAlert>
}
else
{
    @if (!string.IsNullOrEmpty(Message))
    {
        <MudAlert Severity="@(IsErrorMessage ? Severity.Error : Severity.Success)" Class="my-4">@Message</MudAlert>
    }

    <MudCard Outlined="true" Class="mt-6">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Registered teams</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudDataGrid T="ManagedTeamDto" Items="@ManagedTeams" Dense="true" Hover="true" Bordered="true" Striped="true" SortMode="SortMode.Multiple">
            <Columns>
                <PropertyColumn Property="x => x.TeamName" Title="Team" />
                <PropertyColumn Property="x => x.IsArchived" Title="Status">
                    <CellTemplate>
                        <MudChip T="string" Color="@(context.Item.IsArchived ? Color.Error : Color.Success)">
                            @(context.Item.IsArchived ? "Archived" : "Active")
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.TotalScore" Title="Total score" />
                <PropertyColumn Property="x => x.ChallengesSucceeded" Title="Succeeded / failed">
                    <CellTemplate>
                        <MudText Color="Color.Success" Typo="Typo.body2" Class="d-inline">@context.Item.ChallengesSucceeded</MudText>
                        <span class="mx-1">/</span>
                        <MudText Color="Color.Error" Typo="Typo.body2" Class="d-inline">@context.Item.ChallengesFailed</MudText>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.SubmissionCount" Title="Submissions" />
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudTooltip Text="View report">
                            <MudIconButton Icon="@Icons.Material.Filled.Assessment"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           Href="@($"/reports/{context.Item.TeamId}")" />
                        </MudTooltip>
                        <MudTooltip Text="Reset all challenges (removes all submissions)">
                            <MudIconButton Icon="@Icons.Material.Filled.RestartAlt"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           Disabled="@(context.Item.SubmissionCount == 0)"
                                           OnClick="@(() => ResetAllChallenges(context.Item.TeamId))" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudCard>
}
