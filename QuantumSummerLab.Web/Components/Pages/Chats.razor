@using MediatR
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using QuantumSummerLab.Application.Teams.Commands
@using QuantumSummerLab.Application.Teams.Queries

@inject ProtectedLocalStorage ProtectedLocalStore
@inject IMediator Mediator

@page "/chats"

<PageTitle>Quantum Summer Lab - Chat history</PageTitle>

<MudText Typo="Typo.h4" Class="my-4">Chat history</MudText>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (!IsLoggedIn)
{
    <MudAlert Severity="Severity.Info" Class="my-4">You need to log in before accessing chat history.</MudAlert>
}
else if (!IsAdmin)
{
    <MudAlert Severity="Severity.Warning" Class="my-4">Only approved admin teams can access this page.</MudAlert>
}
else
{
    <MudCard Outlined="true" Class="mt-6">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Registered teams</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudDataGrid T="ManagedTeamDto" Items="@ManagedTeams" Dense="true" Hover="true" Bordered="true" Striped="true" SortMode="SortMode.Multiple">
            <Columns>
                <PropertyColumn Property="x => x.TeamName" Title="Team" />
                <PropertyColumn Property="x => x.IsArchived" Title="Status">
                    <CellTemplate>
                        <MudChip T="string" Color="@(context.Item.IsArchived ? Color.Error : Color.Success)">
                            @(context.Item.IsArchived ? "Archived" : "Active")
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.MessagesSent" Title="Messages sent" />
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudButton Variant="Variant.Filled"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Forum"
                                   Href="@($"/chats/{context.Item.TeamId}")">
                            View chat history
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudCard>
}
